.fnDivideFloatLp
rol  r4			; Rotate carry bit into r1:r3:r4 result
rol  r3
rol  r1
asl  r2			; Rotate dividend
rol  r0
bcs  fnDivideSubtract
.fnDivideStart
cmp  10(sp),r0
bcs  fnDivideSubtract	; hi(stk) < hi(reg)
