jsr  pc,fnABSint	; Ensure positive

; sp=>retaddr, sign:tkn, r4, r3 RHS
; 6(sp):4(sp)= RHS             Z80 D
;    r0:r1   = remainder       Z80 A
;    r2=32   = bit counter     Z80 B
;    r3:r4   = LHS and result  Z80 C
