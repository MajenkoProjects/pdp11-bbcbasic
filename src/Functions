mov #32,r2		; LD  B,8   - bit counter
clr r1			; XOR A     - remainder
clr r0
.fnDIVlp
clc
rol r4			; SLA C     - rotate a bit out of LHS
rol r3
rol r1			; RLA       - rotate the bit into remainder
rol r0
cmp r0,6(sp)		; CP D b16-b31
beq fnDIVagain
bcs fnDIVnoAdd
bcc fnDIVAdd
.fnDIVagain
cmp r1,4(sp)		; CP D b0-b15
bcs fnDIVnoAdd		; JR C,noadd
.fnDIVAdd
add #1,r4		; INC C
adc r3
sub 4(sp),r1		; SUB D
sbc r0
sub 6(sp),r0
.fnDIVnoAdd
