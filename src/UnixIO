mov  r4,-(sp)
mov  r3,-(sp)
mov  r2,-(sp)
mov  r1,-(sp)
mov  r0,r4		; r4=0/1 -> Load/Save
mov  r1,r2		; r2=>control block

; Get filename and open file
; --------------------------
