movb SV_KBDQ,r0
bne  KBD_WaitKeyPend		; Get pending keypress
jsr  pc,UNIX_BGET0		; Read from STDIN
tstb SV_KBDQ
beq  KBD_WaitKeyOk		; Not <SIGINT>, return it
.KBD_WaitKeyPend
movb SV_KBDBUF,r0		; Get pending keypress
.KBD_WaitKeyOk
clrb SV_KBDQ			; Clear queue, clear C
rts  pc


