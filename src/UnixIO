clr  r0			; &r0:r1=length of file
mov  (sp),r2		; Get address of control block back
add  #10,r2		; Point to 'length' in control block
jsr  pc,StoreWord
mov  r5,r0		; r0=handle
jsr  pc,UX_CloseR0	; close(handle)
mov  (sp)+,r1
mov  (sp)+,r2
mov  (sp)+,r3
mov  (sp)+,r4
mov  (sp)+,r5
mov  #1,r0		; Return 'File found'
rts  pc

