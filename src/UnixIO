cmpb r0,#255
beq  UX_ArgsFF		; ARGS &FF - Update files
tst  r1
bne  UX_ARGS		; Handle<>0, open file information
tst  r0
bne  UX_ARGSbbc		; Not read FS number, pass on to BBC vector
#ifndef BSD211
 #ifndef NOEMT
