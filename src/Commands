bic  #&FF00,r2
.cmdINPUTchnAssign
jmp  cmdAssign4
;
.cmdINPUTchnStr
jsr  pc,IO_BGET		; Get string marker
jsr  pc,IO_BGET		; Get string length
adr  SV_STRING,r4	; r4=string start
