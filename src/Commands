jsr  pc,IO_BGET		; &FF real, <>&FF int
mov  r0,-(sp)		; Save int/real flag
mov  #2,r2		; Make two passes to get two words
.cmdINPUTchnIntLp
mov  r4,r3
jsr  pc,IO_BGET		; b24-b31 then b8-b15
