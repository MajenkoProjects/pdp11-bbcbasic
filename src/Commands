; INPUT#chn,{items...} - Input from open file
; -------------------------------------------
.cmdINPUTchn
jsr  pc,EvalHashInt1	; Step past '#', get channel
mov  r4,-(sp)		; Save channel
.cmdINPUTchnLp
jsr  pc,SkipSpaceThis	; Get current character
cmpb r0,#ASC","		; r0=next character
bne  cmdINPUTchnEnd
jsr  pc,cmdINPUTchnRead	; Read from file and assign
br   cmdINPUTchnLp
;.cmdINPUTchnEnd
;tst  (sp)+		; Drop channel
;rts  pc
;
.cmdINPUTchnRead
inc  r5			; Step past comma
jsr  pc,VarFindCreate	; Parse and create variable
mov  2(sp),r1		; Get channel
