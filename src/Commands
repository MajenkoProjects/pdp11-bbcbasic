beq  cmdINPUTchnStrAssign ; Null string
mov  r0,r2		; r2=string count
add  r2,r4		; r4=>end of string
inc  r4			; Balance pre-decrement
.cmdINPUTchnStrLp
jsr  pc,IO_BGET		; Get character
movb r0,-(r4)		; Store it
dec  r2
bne  cmdINPUTchnStrLp	; Loop until no more chars
